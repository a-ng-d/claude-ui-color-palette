{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ui-color-palette",
  "version": "1.0.9",
  "description": "Design color palettes, audit contrast, generate code, and sync to Figma, Penpot, Sketch, and Framer — powered by the UI Color Palette API",
  "author": {
    "name": "Aurélien Grimaud",
    "url": "https://github.com/a-ng-d",
    "email": "a.grimaud@involt.io"
  },
  "homepage": "https://uicp.ylb.lt/docs-claude",
  "repository": "https://github.com/a-ng-d/claude-ui-color-palette",
  "documentationUrl": "https://uicp.ylb.lt/docs-claude",
  "supportUrl": "https://uicp.ylb.lt/support",
  "privacyPolicyUrl": "https://uicp.ylb.lt/privacy",
  "termsOfServiceUrl": "https://uicp.ylb.lt/terms",
  "license": "MIT",
  "keywords": [
    "color",
    "palette",
    "design-system",
    "figma",
    "penpot",
    "sketch",
    "framer",
    "accessibility",
    "wcag",
    "tokens"
  ],
  "userConfig": {
    "penpot_token": {
      "type": "string",
      "title": "Penpot MCP key",
      "description": "Your Penpot Cloud MCP key, used only to connect to design.penpot.app. Find it in Penpot → Your account → Integrations → MCP Server.",
      "sensitive": true,
      "required": false
    }
  }
}
